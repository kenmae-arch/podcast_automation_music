# ============ APIキー ============
# Fish Audio API キー: https://fish.audio で取得(音声化に必須)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Gemini API キー(geminiモードを使う場合のみ): https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# Groqを使う場合のみ: https://console.groq.com で無料取得
# GROQ_API_KEY=your_groq_api_key_here

# ============ LLM設定 ============
# "manual"(既定・Claude Code等が書いた台本を使う) / "gemini" / "groq"
LLM_PROVIDER=manual
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ============ TTS設定 ============
# Fish Audioのボイスライブラリで選んだ声のID。
# 未指定なら番組公式ボイス(config.py の既定値 63bc41e652214372b15d9416a30a60b4)
# FISH_AUDIO_REFERENCE_ID=
# 1リクエストあたりの最大文字数
# TTS_CHUNK_SIZE=1500

# ============ 配信設定 ============
# GitHub Pagesの公開URL(必須。例: https://<username>.github.io/<repo>)
SITE_BASE_URL=https://kenmae-arch.github.io/podcast_automation_jrap
# 独自ドメイン移行後の例:
# FEED_BASE_URL=https://feed.example.jp
# MEDIA_BASE_URL=https://media.example.jp
# PODCAST_NEW_FEED_URL=https://feed.example.jp/feed.xml

# ============ ポッドキャスト情報 ============
PODCAST_TITLE=日本語ラップ アルバム全曲解説
PODCAST_DESCRIPTION=日本語ラップの名盤を1曲ずつ深掘り解説するポッドキャスト。制作背景・リリックのテーマ・音楽的な仕掛けを、1話1曲でじっくり語ります。
PODCAST_AUTHOR=アルバム全曲解説
PODCAST_EMAIL=podcast@example.com
PODCAST_CATEGORY=Music
# 番組カバー画像(docs/ 直下)のファイル名。既定: cover-v1.jpg
# 差し替えるときは中身だけでなくファイル名も変えること(配信先がURL単位で
# キャッシュするため、同名のままでは反映されない)
# PODCAST_COVER_FILE=cover-v1.jpg
